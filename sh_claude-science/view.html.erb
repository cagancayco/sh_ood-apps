<%-
  # generate form id, based on host and port
  form_id = Digest::SHA1.hexdigest("--" + host.to_s + "--" + port.to_s + "--")
-%>

<!--
  This posts to the login helper (template/bin/cs-login.py), not to
  claude-science itself: the daemon only signs a browser in through a single-use
  link that expires within minutes, so the helper mints one per click and
  redirects there.
-->
<form id="<%= form_id %>" action="/rnode/<%= host %>/<%= port %>/?token=<%= password %>" method="post" target="_blank">
  <button class="btn btn-primary" type="submit">
    <i class="fa fa-flask"></i> Connect to Claude Science
  </button>
</form>
